<Window x:Class="SmartHotelManagement.Views.Login_Hotel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartHotelManagement.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Login"
        Height="500"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid>

        
        <Border Width="260"
                Height="330"
                Background="White"
                CornerRadius="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="100,80,0,0">

            <Grid>

                <TextBlock Text="Đăng Nhập"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0056FC"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"
                           VerticalAlignment="Top"/>

                <TextBlock Text="👤"
                           FontSize="18"
                           Margin="20,110,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                <TextBox x:Name="txtUsername"
                         Width="150"
                         Height="30"
                         Margin="55,105,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"/>

                <TextBlock Text="🔒"
                           FontSize="18"
                           Margin="20,160,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                <PasswordBox x:Name="txtPassword"
                             Width="150"
                             Height="30"
                             Margin="55,155,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"/>

                <Button Content="Đăng nhập"
                        Width="120"
                        Height="35"
                        Margin="70,240,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#0056FC"
                        Foreground="White"
                        Click="Login_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>